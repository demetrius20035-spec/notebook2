# ─────────────────────────────────────────────────────────────────────
#  RepairExpert AI — пример файла окружения. Скопируйте в `.env`.
# ─────────────────────────────────────────────────────────────────────

# ── База данных (MariaDB) ──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=repair_expert
DB_USER=repairapp
DB_PASSWORD=change_me_strong
DB_ROOT_PASSWORD=change_me_root

# ── Qdrant ──
# QDRANT_MODE: server | local | memory
#   server — внешний сервер Qdrant (Docker или нативная установка) по host:port
#   local  — встроенный режим без сервера: вектора в папке QDRANT_LOCAL_PATH
#            (рекомендуется, если нет Docker — например, на Windows)
#   memory — встроенный режим в ОЗУ (для тестов, данные не сохраняются)
QDRANT_MODE=local
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_LOCAL_PATH=./qdrant_storage

# ── Файловое хранилище ──
STORAGE_BACKEND=local          # local | minio
STORAGE_LOCAL_PATH=./storage

# ── MinIO (если STORAGE_BACKEND=minio) ──
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=change_me_minio
MINIO_BUCKET=repairexpert

# ── Безопасность ──
# JWT_SECRET — минимум 256 бит (32+ случайных байта, hex/base64).
JWT_SECRET=replace_with_64_hex_chars_or_more_0123456789abcdef0123456789abcd
JWT_EXPIRE_HOURS=8
JWT_REFRESH_DAYS=30
# DEVICE_PASSWORD_KEY — ровно 32 байта в base64 (для AES-256-GCM).
DEVICE_PASSWORD_KEY=

# ── Backend ──
API_HOST=127.0.0.1
API_PORT=8077
LOG_LEVEL=INFO

# ── LLM по умолчанию ──
# Допустимо: ollama | openai | anthropic | grok | openrouter |
#            lmstudio | openai_compat | yandex | gigachat
DEFAULT_LLM_PROVIDER=ollama

# Ollama (локально, оффлайн)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# xAI Grok
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-2-latest

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-70b-instruct

# LM Studio (локальный OpenAI-совместимый сервер)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# vLLM / llama.cpp (OpenAI-совместимый)
OPENAI_COMPAT_BASE_URL=http://localhost:8000/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# ── Yandex Cloud (Алиса / YandexGPT) ──
# Пример из материалов заказчика (LLM.txt, раздел 1).
YANDEX_CLOUD_FOLDER=
YANDEX_CLOUD_API_KEY=
# aliceai-llm/latest | yandexgpt-5.1/latest | yandexgpt-lite/latest …
YANDEX_CLOUD_MODEL=yandexgpt-5.1/latest

# ── Sber GigaChat ──
# Пример из материалов заказчика (LLM.txt, раздел 2).
# GIGACHAT_AUTH_KEY — это значение заголовка Authorization: Basic <...>
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS    # GIGACHAT_API_PERS | _B2B | _CORP
GIGACHAT_MODEL=GigaChat-2           # GigaChat-2 | GigaChat-2-Pro | GigaChat-2-Max
# Проверка нецензурной лексики (см. пример)
GIGACHAT_PROFANITY_CHECK=true
# По умолчанию Sber требует их корневой сертификат «Минцифры».
# Укажите путь к .pem или оставьте false, чтобы отключить проверку TLS.
GIGACHAT_VERIFY_SSL=false

# ── Эмбеддинги ──
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://localhost:11434
EMBEDDING_DIM=1024

# ── OCR ──
TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_LANG=rus+eng

# ── Реквизиты организации (для документов) ──
ORG_NAME=Сервисный центр «RepairExpert»
ORG_INN=0000000000
ORG_ADDRESS=
ORG_PHONE=
ORG_EMAIL=
ORG_LOGO_PATH=
